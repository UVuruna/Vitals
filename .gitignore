# User-specific runtime config (not committed)
config/last_setup.json

# Build outputs
exe/
dist/
build/
*.spec
setup/version_info.txt

# Code signing certificate (never commit)
setup/cert/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE
.vscode/
.idea/

# Claude Code: the enforcement hooks MUST survive a clone, so settings.json is
# tracked. Everything else under .claude/ (local overrides, session state) is not.
.claude/*
!.claude/settings.json

# Virtual environment
venv/
.venv/

# Debug logs (opt-in via PMUSAGE_DEBUG=1)
logs/
network_debug.log

# Owner inbox - local only (root Rule #18)
UV/
